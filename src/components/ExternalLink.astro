---
// A link that opens in a new tab, with an icon and a spoken hint so nobody is surprised.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const { href, rel = "noopener", ...rest } = Astro.props;
---

<a href={href} target="_blank" rel={rel} {...rest}>
  <slot />
  <svg class="icon-external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
  </svg>
  <span class="visually-hidden">(opens in a new tab)</span>
</a>
