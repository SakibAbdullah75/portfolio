---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results and omit canonical tags (used by the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
// Astro.site is set in astro.config.mjs; without it there is no canonical URL.
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Runs before the page paints: apply the saved theme so there is no
      // flash, and mark that JavaScript is available so reveal animations
      // can start hidden.
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (error) {}
        root.dataset.theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Scroll-reveal: elements with data-reveal fade up when they enter the
  // viewport. Items already on screen reveal immediately after load.
  // Printing is handled purely in CSS (see the print block in global.css).
  const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduceMotion || !("IntersectionObserver" in window)) {
    targets.forEach((element) => element.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      // threshold 0: reveal as soon as any part is on screen, so even a very
      // long article is never stuck hidden. The bottom margin only applies when
      // the page can actually scroll, otherwise elements near the bottom edge
      // of a short page would never trigger.
      {
        rootMargin: document.documentElement.scrollHeight > window.innerHeight ? "0px 0px -8% 0px" : "0px",
        threshold: 0,
      },
    );
    targets.forEach((element) => observer.observe(element));
  }

  // Keep the footer year current even if the site is not rebuilt for a while.
  const year = document.querySelector("[data-year]");
  if (year) year.textContent = String(new Date().getFullYear());
</script>
